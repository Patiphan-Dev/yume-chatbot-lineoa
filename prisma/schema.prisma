generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model LineUser {
  id                String             @id @default(cuid())
  lineUserId        String             @unique
  displayName       String?
  pictureUrl        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  conversationState ConversationState?
  insuranceRequests InsuranceRequest[]

  @@map("line_users")
}

model ConversationState {
  id                    String         @id @default(cuid())
  lineUserId            String         @unique
  step                  ConversationStep @default(MAIN_MENU)
  selectedService       Service?
  selectedInsuranceType InsuranceType?
  updatedAt             DateTime       @updatedAt
  user                  LineUser       @relation(fields: [lineUserId], references: [lineUserId])

  @@map("conversation_states")
}

model InsuranceRequest {
  id              String        @id @default(cuid())
  lineUserId      String
  insuranceType   InsuranceType
  status          RequestStatus @default(PENDING)
  carRegistration String?
  province        String?
  brand           String?
  model           String?
  year            Int?
  chassisNumber   String?
  quotedPremium   Int?
  quoteNote       String?
  quotedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            LineUser      @relation(fields: [lineUserId], references: [lineUserId])
  attachments     QuoteAttachment[]

  @@map("insurance_requests")
}

// Documents staff attach when quoting (policy summary, coverage table, ...).
// Stored in Postgres and served via the dashboard's public /files/<id> route so
// LINE can fetch images; ids are cuids, unguessable by construction.
model QuoteAttachment {
  id          String           @id @default(cuid())
  requestId   String
  filename    String
  contentType String
  data        Bytes
  createdAt   DateTime         @default(now())
  request     InsuranceRequest @relation(fields: [requestId], references: [id])

  @@map("quote_attachments")
}

// Dashboard staff accounts, managed from the /staff admin page. The master
// admin (username "admin" + STAFF_DASHBOARD_PASSWORD) lives in env, not here.
model StaffMember {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("staff_members")
}

enum ConversationStep {
  MAIN_MENU
  AWAITING_INSURANCE_TYPE
  AWAITING_CAR_INFO
  SUBMITTED
}

enum Service {
  CHECK_PREMIUM
  RENEW_PREMIUM
  INQUIRY
  OTHER
}

enum InsuranceType {
  CAR_CLASS_1
  CAR_CLASS_2_3
  RENTAL_COMMERCIAL
  LUXURY_SUPERCAR
  EV
  FIRE
  CONSTRUCTION
  OTHER
}

enum RequestStatus {
  PENDING
  IN_REVIEW
  QUOTED
  CLOSED
}
