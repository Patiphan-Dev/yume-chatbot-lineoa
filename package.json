{
  "name": "yume-chatbot-lineoa",
  "version": "0.1.0",
  "private": true,
  "description": "LINE OA webhook backend for YUME Insurance premium-check flow",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "mkdir -p dist/richMenu/assets && cp src/richMenu/assets/*.png src/richMenu/assets/*.jpg dist/richMenu/assets/",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "richmenu:setup": "ts-node src/scripts/setupRichMenu.ts"
  },
  "dependencies": {
    "@line/bot-sdk": "^9.5.0",
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
