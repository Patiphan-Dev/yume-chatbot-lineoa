# Same Postgres database as the webhook backend — this app reads/writes the same tables.
DATABASE_URL=postgresql://user:password@localhost:5432/yume_chatbot

# Shared password for the small internal staff team (single-login, no per-user accounts yet).
STAFF_DASHBOARD_PASSWORD=change-me

# Long random string used to sign the staff session cookie, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Same Messaging API channel access token as the webhook backend, used to push quote results.
LINE_CHANNEL_ACCESS_TOKEN=
