# Same Postgres database as the webhook backend — this app reads/writes the same tables.
# Get both from Supabase: Project > Connect > ORM. DIRECT_URL isn't read by this app directly,
# but the shared prisma/schema.prisma (symlinked in) references it, so `prisma generate` needs it set.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Shared password for the small internal staff team (single-login, no per-user accounts yet).
STAFF_DASHBOARD_PASSWORD=change-me

# Long random string used to sign the staff session cookie, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Same Messaging API channel access token as the webhook backend, used to push quote results.
LINE_CHANNEL_ACCESS_TOKEN=
