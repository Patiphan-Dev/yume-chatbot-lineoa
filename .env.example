# LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE group/user id that receives new-request notifications (add the bot to a group, read the joined event log for its id)
LINE_STAFF_GROUP_ID=

# LIFF app that hosts the car-info form for step 4 of the flow
LIFF_APP_URL=https://liff.line.me/xxxxxxxxxx-xxxxxxxx

# Origin the LIFF form (liff/) is deployed at — allowed via CORS for /api/liff
LIFF_APP_ORIGIN=https://your-liff-app.vercel.app

# Channel ID the LIFF app is registered under — usually the same Messaging API channel above.
LINE_LOGIN_CHANNEL_ID=

# Set after running `npm run richmenu:setup` once (optional — see src/scripts/setupRichMenu.ts)
LINE_RICH_MENU_ID=

DATABASE_URL=postgresql://user:password@localhost:5432/yume_chatbot

PORT=3000
